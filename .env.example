# Server-side Firebase REST configuration. Sites stores FIREBASE_API_KEY as a secret.
# Firestore Security Rules remain the authorization boundary; never use a service-account key.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# First-party policy operator. The OpenAI key is server-only. Restrict access
# to the intended workspace owners while the operator is in limited release.
OPENAI_API_KEY=
OPERATOR_ALLOWED_EMAILS=

# GitHub OAuth App used by the first-party operator. Set its homepage to the
# RuleRipple origin and its callback to https://YOUR_RULE_RIPPLE_HOST/api/github/callback.
# The implementation requests public_repo and read:user; create a separate app
# for each environment whose callback origin differs.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional, host-approved public repository for the bounded confirmation
# workflow (ruleripple-confirmation.yml on main). Never supplied by an agent.
GITHUB_NOTIFICATION_REPOSITORY=

# Server-only 32-byte random key, hex encoded (64 characters). Used to seal
# scoped worker credentials. Rotation invalidates every existing connection.
# Never prefix with NEXT_PUBLIC_ or copy this key to workers.
AGENT_CREDENTIAL_KEY=
